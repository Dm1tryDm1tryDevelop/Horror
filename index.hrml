<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Побег от Ырки</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #000; touch-action: none; font-family: sans-serif; }
        canvas { display: block; }
        #ui-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
        #joystick-zone { position: absolute; bottom: 20px; left: 20px; width: 150px; height: 150px; pointer-events: auto; }
        #camera-zone { position: absolute; top: 0; right: 0; width: 50%; height: 100%; pointer-events: auto; }
        #message { position: absolute; top: 20px; width: 100%; text-align: center; color: #fff; font-size: 24px; text-shadow: 2px 2px 5px #000; pointer-events: none; }
        #start-screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; color: red; display: flex; flex-direction: column; justify-content: center; align-items: center; pointer-events: auto; z-index: 10; }
        button { padding: 15px 30px; font-size: 20px; background: #333; color: white; border: 2px solid red; cursor: pointer; border-radius: 10px; margin-top: 20px; }
        #screamer { position: absolute; top:0; left:0; width: 100%; height: 100%; background: url('https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Skull_and_crossbones.svg/500px-Skull_and_crossbones.svg.png') center/contain no-repeat red; z-index: 100; display: none; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/nipplejs/0.9.0/nipplejs.min.js"></script>
</head>
<body>

    <div id="start-screen">
        <h1>ТЕМНЫЙ ЛЕС</h1>
        <p>Найди ворота "ВЫХОД". Остерегайся Ырки.</p>
        <p>Управление: Левая часть - ходьба, Правая - осмотр.</p>
        <button id="start-btn">Начать игру</button>
    </div>

    <div id="ui-layer">
        <div id="message">Найди ВЫХОД</div>
        <div id="joystick-zone"></div>
        <div id="camera-zone"></div>
    </div>
    
    <div id="screamer"></div>

    <script>
        let scene, camera, renderer, monster, exitGate;
        let moveForward = 0, moveRight = 0;
        let isGameRunning = false;

        // Настройка аудио контекста для генерации жутких звуков
        let audioCtx;

        document.getElementById('start-btn').addEventListener('click', () => {
            document.getElementById('start-screen').style.display = 'none';
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            init();
            animate();
            isGameRunning = true;
            playAmbiance();
        });

        function init() {
            // 1. Сцена и туман
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x050505, 0.08);

            // 2. Камера и фонарик
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.y = 1.6; // Рост человека

            const flashlight = new THREE.SpotLight(0xffffff, 1.5, 30, Math.PI / 6, 0.5, 1);
            flashlight.position.set(0, 0, 0);
            flashlight.target.position.set(0, 0, -1);
            camera.add(flashlight);
            camera.add(flashlight.target);
            scene.add(camera);

            const ambientLight = new THREE.AmbientLight(0x111111);
            scene.add(ambientLight);

            // 3. Рендерер
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setClearColor(0x050505);
            document.body.appendChild(renderer.domElement);

            // 4. Земля
            const planeGeometry = new THREE.PlaneGeometry(200, 200);
            const planeMaterial = new THREE.MeshLambertMaterial({ color: 0x1a2e1a });
            const plane = new THREE.Mesh(planeGeometry, planeMaterial);
            plane.rotation.x = -Math.PI / 2;
            scene.add(plane);

            // 5. Лес (генерация деревьев)
            const treeGeo = new THREE.CylinderGeometry(0.2, 0.5, 5, 8);
            const treeMat = new THREE.MeshLambertMaterial({ color: 0x3d2817 });
            const leavesGeo = new THREE.ConeGeometry(2, 6, 8);
            const leavesMat = new THREE.MeshLambertMaterial({ color: 0x0f210f });

            for (let i = 0; i < 200; i++) {
                const x = (Math.random() - 0.5) * 150;
                const z = (Math.random() - 0.5) * 150;
                if (Math.abs(x) < 5 && Math.abs(z) < 5) continue; // Освобождаем центр

                const trunk = new THREE.Mesh(treeGeo, treeMat);
                trunk.position.set(x, 2.5, z);
                
                const leaves = new THREE.Mesh(leavesGeo, leavesMat);
                leaves.position.set(x, 6, z);
                
                scene.add(trunk);
                scene.add(leaves);
            }

            // 6. Монстр (Ырка - базовый силуэт)
            const monsterGeo = new THREE.CylinderGeometry(0.3, 0.3, 2.5, 16);
            const monsterMat = new THREE.MeshBasicMaterial({ color: 0xffffff }); // Белый, светится в темноте
            monster = new THREE.Mesh(monsterGeo, monsterMat);
            monster.position.set(20, 1.25, -20);
            scene.add(monster);

            // 7. Ворота (Выход)
            exitGate = new THREE.Group();
            const pillarGeo = new THREE.BoxGeometry(0.5, 4, 0.5);
            const pillarMat = new THREE.MeshLambertMaterial({ color: 0x555555 });
            const p1 = new THREE.Mesh(pillarGeo, pillarMat); p1.position.set(-2, 2, 0);
            const p2 = new THREE.Mesh(pillarGeo, pillarMat); p2.position.set(2, 2, 0);
            const top = new THREE.Mesh(new THREE.BoxGeometry(4.5, 0.5, 0.5), pillarMat); top.position.set(0, 4, 0);
            exitGate.add(p1); exitGate.add(p2); exitGate.add(top);
            
            // Добавляем красную подсветку выхода
            const exitLight = new THREE.PointLight(0xff0000, 2, 10);
            exitLight.position.set(0, 3, 0);
            exitGate.add(exitLight);
            
            exitGate.position.set(-30, 0, -40);
            exitGate.lookAt(0,0,0);
            scene.add(exitGate);

            // 8. Управление
            setupControls();
        }

        function setupControls() {
            // Джойстик для ходьбы
            const manager = nipplejs.create({
                zone: document.getElementById('joystick-zone'),
                mode: 'static',
                position: { left: '50%', top: '50%' },
                color: 'white'
            });

            manager.on('move', (e, data) => {
                moveForward = Math.cos(data.angle.radian) * data.distance * 0.001;
                moveRight = Math.sin(data.angle.radian) * data.distance * 0.001;
            });
            manager.on('end', () => { moveForward = 0; moveRight = 0; });

            // Свайпы для поворота камеры
            const cameraZone = document.getElementById('camera-zone');
            let isDragging = false;
            let previousTouch;

            cameraZone.addEventListener('touchstart', (e) => {
                isDragging = true;
                previousTouch = e.touches[0];
            });

            cameraZone.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                const touch = e.touches[0];
                const movementX = touch.pageX - previousTouch.pageX;
                const movementY = touch.pageY - previousTouch.pageY;

                camera.rotation.y -= movementX * 0.005;
                camera.rotation.x -= movementY * 0.005;
                // Ограничение наклона головы
                camera.rotation.x = Math.max(-Math.PI/2, Math.min(Math.PI/2, camera.rotation.x));
                
                previousTouch = touch;
            });

            cameraZone.addEventListener('touchend', () => { isDragging = false; });
        }

        // Жуткий гул (Web Audio API)
        function playAmbiance() {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.value = 40; // Низкочастотный гул
            gain.gain.value = 0.5;
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
        }

        // Звук скримера
        function triggerScreamer() {
            isGameRunning = false;
            document.getElementById('screamer').style.display = 'block';
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(100, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(3000, audioCtx.currentTime + 0.1);
            gain.gain.setValueAtTime(1, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 1);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 1.5);

            setTimeout(() => { location.reload(); }, 2000);
        }

        function animate() {
            if (!isGameRunning) return;
            requestAnimationFrame(animate);

            // Движение игрока относительно направления камеры
            const direction = new THREE.Vector3();
            camera.getWorldDirection(direction);
            direction.y = 0; direction.normalize();

            const right = new THREE.Vector3();
            right.crossVectors(direction, camera.up).normalize();

            camera.position.addScaledVector(direction, moveRight * 0.1); // NippleJS углы смещены
            camera.position.addScaledVector(right, moveForward * 0.1);

            // Логика монстра (преследование)
            const distToMonster = camera.position.distanceTo(monster.position);
            if (distToMonster < 25) {
                // Монстр смотрит на игрока и идет к нему
                monster.lookAt(camera.position.x, monster.position.y, camera.position.z);
                monster.translateZ(0.04); 
                // Анимация шагов (покачивание)
                monster.position.y = 1.25 + Math.sin(Date.now() * 0.01) * 0.2;
            }

            // Проверка столкновения со скримером
            if (distToMonster < 1.5) {
                triggerScreamer();
            }

            // Проверка победы (Дошел до выхода)
            if (camera.position.distanceTo(exitGate.position) < 3) {
                isGameRunning = false;
                alert("ТЫ СБЕЖАЛ!");
                location.reload();
            }

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
